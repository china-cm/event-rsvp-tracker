{
  "consumer": {
    "name": "event-rsvp-frontend"
  },
  "interactions": [
    {
      "description": "a request to create an event",
      "providerStates": [
        {
          "name": "an organizer wants to create an event"
        }
      ],
      "request": {
        "body": {
          "description": "Planning day",
          "location": "Makati",
          "starts_at": "2026-11-15T09:00:00.000Z",
          "title": "Team Offsite"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/events"
      },
      "response": {
        "body": {
          "event": {
            "created_at": "2026-09-01T00:00:00.000Z",
            "description": "Planning day",
            "id": "11111111-1111-1111-1111-111111111111",
            "location": "Makati",
            "starts_at": "2026-11-15T09:00:00.000Z",
            "title": "Team Offsite"
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.event.created_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.event.description": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.event.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.event.location": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.event.starts_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.event.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 201
      }
    },
    {
      "description": "a request to submit an RSVP",
      "providerStates": [
        {
          "name": "an event exists",
          "params": {
            "eventId": "11111111-1111-1111-1111-111111111111"
          }
        }
      ],
      "request": {
        "body": {
          "email": "maria@example.com",
          "guest_count": 1,
          "name": "Maria Santos",
          "status": "yes"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/events/11111111-1111-1111-1111-111111111111/rsvps"
      },
      "response": {
        "body": {
          "rsvp": {
            "created_at": "2026-09-05T00:00:00.000Z",
            "email": "maria@example.com",
            "event_id": "11111111-1111-1111-1111-111111111111",
            "guest_count": 1,
            "id": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
            "name": "Maria Santos",
            "status": "yes"
          }
        },
        "generators": {
          "body": {
            "$.rsvp.id": {
              "type": "Uuid"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.rsvp.created_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.rsvp.email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.rsvp.event_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.rsvp.guest_count": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.rsvp.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.rsvp.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.rsvp.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 201
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.7",
      "models": "1.3.15"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "event-rsvp-api"
  }
}